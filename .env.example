POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
ANTHROPIC_API_KEY=sk-ant-tu-clave-aqui

# Que restaurante sirve esta instancia. Evita tener "la-catedral" escrito
# a mano en el codigo.
RESTAURANTE_ID=barX

# Ponlo a true SOLO despues de ejecutar scripts/migrar_carta_a_bd.py y
# comprobar que las tablas tienen datos. Con POSTGRES_* puestas pero esto en
# false, la carta se sigue leyendo de datos/<restaurante>/*.json: evita
# servir una tabla `platos` vacia el dia que se despliegue este codigo antes
# de migrar.
CARTA_BD_ACTIVA=false

# Ponlo a true SOLO si despliegas detras de un proxy de confianza (nginx,
# Cloudflare). Si no, un atacante puede falsificar X-Forwarded-For y saltarse
# el limite de peticiones.
CONFIAR_PROXY=false
# Tope de gasto diario en LLM por restaurante (USD). Al alcanzarlo, el chat
# deja de llamar al modelo y responde derivando al personal.
TOPE_DIARIO_USD=5.0

# Logs en JSON para produccion (los agrega cualquier gestor de logs).
LOGS_JSON=false

# Firma las cookies de sesion del panel de gestion (/admin). Si se deja
# vacio, se genera una al arrancar: las sesiones no sobreviven a un reinicio
# ni se comparten entre varias instancias. En produccion conviene fijarlo.
SESION_SECRETO=

# Contrasena del panel /superadmin (da de alta restaurantes nuevos). Es un
# hash, no la contrasena en claro: generarlo con
#   uv run python -c "from carta_bar.auth import hash_clave; import getpass; print(hash_clave(getpass.getpass()))"
# OJO al pegarlo en un .env que lea docker-compose: el hash lleva simbolos
# '$', y docker-compose intenta interpolarlos como si fueran variables. Hay
# que escribir cada '$' como '$$', o al leer el .env el hash queda roto en
# silencio (docker compose avisa con "variable is not set", pero el
# contenedor arranca igual, con una clave que ya no coincide con ninguna
# contrasena real).
SUPERADMIN_CLAVE_HASH=

# Dominio bajo el que viven las cartas (<restaurante>.<dominio>): lo usa el
# codigo QR del panel para saber a que direccion apunta cada bar.
DOMINIO_BASE=jurux.app

# Modelo con el que se traducen los platos (una vez por plato, al crearlo o editarlo).
# Por defecto claude-sonnet-5: traduce mejor que Haiku y cuesta centimos. Si pones
# otro, añade su precio en PRECIOS_POR_MODELO (src/carta_bar/costes.py).
# MODELO_TRADUCCION=claude-sonnet-5
